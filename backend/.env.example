# ============================================================
#  AI 科研问答系统 · 示例环境变量
#  使用方式：复制本文件为 .env，然后填入真实值
#    Copy-Item .env.example .env
# ============================================================

# ---------- LLM（DeepSeek） ----------
DEEPSEEK_API_KEY=sk-在这里填写你的DeepSeek密钥
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 系统标识 ----------
SYSTEM_NAME=AI-RESEARCH

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=lsb_agent_db

# ---------- Redis（登录会话） ----------
# 默认使用 0 号库；若 Redis 设置了密码，可写为 redis://:密码@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
# 多个应用共用同一 Redis 库时，用不同前缀隔离键
REDIS_TOKEN_PREFIX=lsb:auth:token:
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# ---------- JWT ----------
# 注意：HS256 要求密钥不短于 32 字节，否则 PyJWT 会给出 InsecureKeyLengthWarning
JWT_SECRET=ai-research-jwt-secret-change-me-at-least-32-bytes
JWT_EXPIRE_DAYS=7

# ---------- 服务端口 ----------
BACKEND_PORT=8124
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# ---------- 日志 ----------
# 控制台等级：DEBUG / INFO / SUCCESS / WARNING / ERROR / CRITICAL
# DEBUG 会打印检索细节与工具入参，排查问题时很有用，但日志量大
LOG_LEVEL=INFO
# 是否写日志文件（logs/backend.log 全量、logs/error.log 仅 WARNING 以上）
LOG_TO_FILE=1
# 日志目录，留空则用 backend/logs
LOG_DIR=
# 是否在日志里记录请求参数摘要（用户提问只记前 60 字，不记全文）
LOG_REQUEST_BODY=1
# 控制台颜色：auto（默认）/ 1 强制开 / 0 强制关
# 若终端显示乱码（如 [32m 之类），设为 0；若 IDE 终端没颜色，可试 1
LOG_COLOR=auto
